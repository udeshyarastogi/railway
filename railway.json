{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "java -version && mvn -version && mvn clean package -Dgpg.skip=true -Dmaven.javadoc.skip=true -DskipTests=true"
  },
  "deploy": {
    "startCommand": "./railway-start.sh",
    "healthcheckPath": "/v1/mimoto/actuator/health/railway",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
